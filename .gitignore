# research/.gitignore

# Python bytecode & cache files
__pycache__/
*.py[cod]
*$py.class

# Local experiment telemetry outputs (Keep your repo clean!)
*.png
outputs/first_run_base/baseline_matrix_weights_base.json

# Virtual environments (if you use them locally)
venv/
.venv/
env/

# IDE files
.vscode/
.idea/

# Native C build artifacts
c/server
c/bench_baselines
c/bench_hybrid
c_dispatch/benchmark_suite
c_dispatch/bench_e2e
c_dispatch/bench_level5_demo
c_dispatch/bench_prims
c_dispatch/server
*.o
*.log
c_dispatch/*.log
c_dispatch/host_profile.json
